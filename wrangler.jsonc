// Cloudflare Workers static-assets deploy for the built site.
// Explicit config so wrangler skips Vite framework auto-config
// (which refuses Vite 5). Build first, then deploy ./dist.
{
  "name": "portfolio-site",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
